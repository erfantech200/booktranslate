# Copy to .env.local (never commit real values). Web (Vercel) needs only the NEXT_PUBLIC_* pair.

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Worker only (Railway/Fly secrets). Never expose to the web app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler (port 6543). The queue works through it (no LISTEN/NOTIFY).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
STORAGE_DRIVER=supabase            # or "local" for offline dev (LOCAL_STORAGE_DIR)

# ─── OpenAI (worker only) ──────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MAX_RETRIES=5

# Models: config, not code. IDs verified against openai@7.43.0 (docs/openai-api-notes.md).
OCR_MODEL=gpt-6-luna
OCR_REASONING_EFFORT=low           # none|minimal|low|medium|high|xhigh|max
OCR_IMAGE_DETAIL=high              # low|high|auto|original
OCR_MAX_IMAGE_PX=2048
STRUCTURE_MODEL=gpt-6-luna
STRUCTURE_REASONING_EFFORT=low
GLOSSARY_MODEL=gpt-6.1-sol
GLOSSARY_REASONING_EFFORT=medium
TRANSLATION_MODEL=gpt-6.1-sol
TRANSLATION_REASONING_EFFORT=medium
PREMIUM_TRANSLATION_MODEL=gpt-6-astra
PREMIUM_TRANSLATION_REASONING_EFFORT=medium
COMPARE_MODELS=gpt-6.1-sol,gpt-6-astra,gpt-6-luna
PROMPT_CACHE_RETENTION=24h         # in_memory|24h

# ─── Pipeline tuning ───────────────────────────────────────────────────────
TRANSLATION_CHUNK_MIN_TOKENS=1500
TRANSLATION_CHUNK_MAX_TOKENS=2500
TRANSLATION_CONTEXT_BLOCKS=3
TRANSLATION_CONCURRENCY=2
WORKER_CONCURRENCY=4
WORKER_POLL_MS=1500
JOB_LEASE_SECONDS=300
