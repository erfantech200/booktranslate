# Copy to .env.local (never commit real values). On Vercel (Production) these are set:
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY, DATABASE_URL, OPENAI_API_KEY, CRON_SECRET.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Either naming works: SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY, or the older
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server only (worker and admin routes). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Transaction pooler (port 6543). Used by the worker, the migration runner and the health check.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ─── OpenAI (server only) ──────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MAX_RETRIES=5
# Models are config, not code (docs/openai-api-notes.md).
OPENAI_TEXT_MODEL=gpt-6.1-sol            # coaching text, meal plans, chat
OPENAI_TEXT_REASONING_EFFORT=low         # none|minimal|low|medium|high|xhigh|max
OPENAI_VISION_MODEL=gpt-6-luna           # meal photos
OPENAI_VISION_REASONING_EFFORT=low
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare   # exercise illustrations
OPENAI_MONTHLY_BUDGET_USD=20             # month-to-date cap; non-essential AI calls stop above it
PROMPT_CACHE_RETENTION=24h               # in_memory|24h

# ─── Background worker (/api/worker/run) and admin routes ──────────────────
CRON_SECRET=                       # long random string; protects /api/worker/run, /api/admin/*, /api/health details
WORKER_TIME_BUDGET_SECONDS=280     # must stay below the function max duration (300)
WORKER_CLAIM_MIN_SECONDS=120       # don't start a job with less time than this left
WORKER_CONCURRENCY=3
# APP_URL=https://your-app.vercel.app   # optional; otherwise taken from the request
