{
  "name": "coach",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @coach/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @coach/core test",
    "db:test": "bash scripts/db-test.sh",
    "migrate": "pnpm --filter @coach/core migrate",
    "seed:dev": "pnpm --filter @coach/core seed:dev"
  }
}
